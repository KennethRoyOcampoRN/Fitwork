{
  "name": "fitwork",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "create-admin": "npm run create-admin --workspace server",
    "recovery-tool": "npm run recovery-tool --workspace server",
    "setup:certs": "npm run setup:certs --workspace server",
    "seed": "npm run seed --workspace server",
    "backup": "npm run backup --workspace server",
    "restore": "npm run restore --workspace server"
  }
}
