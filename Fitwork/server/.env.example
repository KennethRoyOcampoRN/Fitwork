# --- Database ---
# Preferred: a plain filesystem path to the SQLite file, resolved relative
# to this server/ directory (or use an absolute path). Must be on LOCAL
# disk — do NOT point this at a network share (SMB/NFS/mapped drive):
# SQLite's file locking is not safe over network filesystems and can
# silently corrupt data under concurrent access.
DATABASE_PATH=../data/fitwork.db
# Legacy/advanced: Prisma's own connection string. Only used if
# DATABASE_PATH above is unset. If you set this directly instead, note that
# Prisma resolves a relative `file:` path against server/prisma/ (not this
# server/ directory) — DATABASE_PATH above avoids that gotcha entirely.
# DATABASE_URL="file:../../data/fitwork.db"

PORT=8443
NODE_ENV=development

# standalone (default): bind to localhost only — this PC, no LAN exposure.
# server: bind to all network interfaces — other PCs on the LAN can connect
# (requires the HTTPS certificate to cover this machine's LAN IP/hostname,
# see `npm run setup:certs` and docs/INSTALL.md §4).
# Switching modes is just this value + a restart — no data migration.
SERVER_MODE=standalone

SELF_EDIT_WINDOW_MINUTES=15
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=12
TLS_KEY_PATH=./certs/dev-key.pem
TLS_CERT_PATH=./certs/dev-cert.pem
STORAGE_DIR=../storage

# Local backup destination only (not a network path — see docs/INSTALL.md
# §10). The admin is responsible for manually copying files from here to
# any offsite location (e.g. a shared HRD drive); the app never writes
# backups directly to a network destination.
BACKUP_PATH=../data/backups
